{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  /* `tests` is excluded because `import { test } from "bun:test"` has no types
     without `@types/bun`, and this repository takes no dependency it does not
     ship. `next build` type-checks everything this file includes, so the suite
     would fail the build on that import. Nothing is lost: `bun test`
     transpiles the suite without type-checking it either way. */
  "exclude": ["node_modules", "tests"]
}
