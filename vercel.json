{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/about", "destination": "/#reviewer", "permanent": true },
    { "source": "/work", "destination": "/#doors", "permanent": true },
    { "source": "/standing-agents", "destination": "/custom", "permanent": true },
    { "source": "/og.png", "destination": "/opengraph-image", "permanent": true }
  ],
  "headers": [
    {
      "source": "/opengraph-image",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    }
  ]
}
